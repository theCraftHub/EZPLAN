{
  "name": "ezplan",
  "private": true,
  "version": "0.0.0",
  "description": "Turn any project description into a clear, AI-checked plan your team can track together.",
  "type": "module",
  "workspaces": ["shared", "app", "worker"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run --config vitest.bench.config.ts",
    "typecheck": "tsc -p shared && tsc -p worker && tsc -p app",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": { "node": ">=20" }
}
